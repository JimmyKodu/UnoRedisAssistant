<Page x:Class="UnoRedisAssistant.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:UnoRedisAssistant"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{ThemeResource SystemAccentColor}" Padding="16">
      <TextBlock Text="Redis Assistant" 
                 FontSize="24" 
                 FontWeight="Bold"
                 Foreground="White"/>
    </Border>

    <!-- Main Content -->
    <Grid Grid.Row="1" Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Left Panel: Connection Settings -->
      <StackPanel Grid.Column="0" Spacing="12">
        <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold"/>
        
        <TextBox x:Name="HostTextBox" 
                 Header="Host" 
                 PlaceholderText="localhost"/>
        
        <TextBox x:Name="PortTextBox" 
                 Header="Port" 
                 PlaceholderText="6379"
                 InputScope="Number"/>
        
        <PasswordBox x:Name="PasswordBox" 
                     Header="Password (optional)" 
                     PlaceholderText="Password"/>
        
        <TextBox x:Name="DatabaseTextBox" 
                 Header="Database" 
                 PlaceholderText="0"
                 InputScope="Number"/>
        
        <Button x:Name="ConnectButton" 
                Content="Connect" 
                Click="ConnectButton_Click"
                HorizontalAlignment="Stretch"/>
        
        <Button x:Name="DisconnectButton" 
                Content="Disconnect" 
                Click="DisconnectButton_Click"
                HorizontalAlignment="Stretch"
                IsEnabled="False"/>

        <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="12" 
                Margin="0,12,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Server Info" FontWeight="SemiBold"/>
            <ScrollViewer MaxHeight="200">
              <ItemsControl x:Name="ServerInfoList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" 
                               FontSize="12" 
                               TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Middle Panel: Keys List -->
      <Grid Grid.Column="1" Margin="16,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Keys" 
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          
          <TextBox x:Name="SearchTextBox" 
                   Grid.Column="0"
                   PlaceholderText="Search pattern (e.g., user:*)" 
                   Margin="0,0,8,0"/>
          
          <Button x:Name="SearchButton" 
                  Grid.Column="1"
                  Content="Search" 
                  Click="SearchButton_Click"/>
        </Grid>

        <Border Grid.Row="2" 
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1" 
                CornerRadius="4">
          <ListView x:Name="KeysList" 
                    SelectionChanged="KeysList_SelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Consolas"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Border>
      </Grid>

      <!-- Right Panel: Key Details -->
      <StackPanel Grid.Column="2" Spacing="12">
        <TextBlock Text="Key Details" FontSize="18" FontWeight="SemiBold"/>
        
        <TextBox x:Name="KeyNameTextBox" 
                 Header="Key" 
                 IsReadOnly="True"
                 FontFamily="Consolas"/>
        
        <TextBox x:Name="KeyTypeTextBox" 
                 Header="Type" 
                 IsReadOnly="True"/>
        
        <TextBox x:Name="KeyTtlTextBox" 
                 Header="TTL" 
                 IsReadOnly="True"/>
        
        <TextBox x:Name="KeyValueTextBox" 
                 Header="Value" 
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Height="300"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"/>
        
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="RefreshButton" 
                  Content="Refresh" 
                  Click="RefreshButton_Click"/>
          
          <Button x:Name="DeleteButton" 
                  Content="Delete Key" 
                  Click="DeleteButton_Click"
                  Background="{ThemeResource SystemErrorTextColor}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Status Bar -->
    <Border Grid.Row="2" 
            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" 
            Padding="16,8">
      <TextBlock x:Name="StatusTextBlock" 
                 Text="Not connected" 
                 FontSize="12"/>
    </Border>
  </Grid>
</Page>
